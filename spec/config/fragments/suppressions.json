{
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "check",
      "reason"
    ],
    "anyOf": [
      {
        "required": [
          "file"
        ],
        "properties": {
          "file": true
        }
      },
      {
        "required": [
          "fingerprint"
        ],
        "properties": {
          "fingerprint": true
        }
      }
    ],
    "properties": {
      "check": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.([a-z][a-z0-9-]*|\\*))+$"
      },
      "file": {
        "type": "string",
        "minLength": 1,
        "description": "Site-relative path or glob."
      },
      "fingerprint": {
        "type": "string",
        "pattern": "^[0-9a-f]{16}$",
        "description": "The fingerprint of one finding, from a report."
      },
      "reason": {
        "type": "string",
        "minLength": 3
      },
      "expires": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Last day the suppression applies, inclusive."
      }
    }
  }
}
