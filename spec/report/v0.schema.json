{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/arminazimi/seaworthy/main/spec/report/v0.schema.json",
  "title": "Seaworthy report",
  "description": "The report `seaworthy verify --format json` emits. spec 0 is a draft that changes without notice; it freezes as spec 1 at release.contract-freeze.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checks",
    "errors",
    "findings",
    "root",
    "skipped",
    "spec",
    "summary",
    "suppressed",
    "tool"
  ],
  "properties": {
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "description": "One ready-to-paste prompt that fixes every finding, in report order. Present when the report has findings; generated per finding from its data alone."
    },
    "root": {
      "type": "string",
      "description": "The folder that was verified, as given. Never an absolute path.",
      "not": {
        "pattern": "^([a-zA-Z]:)?[\\\\/]"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skipped"
      }
    },
    "spec": {
      "const": 0
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineStale",
        "baselined",
        "bySeverity",
        "findings",
        "pages",
        "suppressed"
      ],
      "properties": {
        "baselineStale": {
          "type": "integer",
          "minimum": 0
        },
        "baselined": {
          "type": "integer",
          "minimum": 0
        },
        "bySeverity": {
          "type": "object",
          "additionalProperties": false,
          "description": "Counts by severity over all findings the engine reported, including ones `--max-findings` or a per-check cap cut; `summary.findings` may be smaller. The exit code is decided from these counts, so a cap never hides a failure.",
          "properties": {
            "error": {
              "type": "integer",
              "minimum": 1
            },
            "warning": {
              "type": "integer",
              "minimum": 1
            },
            "note": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "changedFiles": {
          "type": "integer",
          "minimum": 0,
          "description": "Present under --changed: findings are limited to files that changed."
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "findingsOmitted": {
          "type": "integer",
          "minimum": 1,
          "description": "Present when --max-findings or a per-check cap cut findings: how many the engine found but the report omits. The kept findings are the report's first, so the omitted ones are exactly the rest, in report order."
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "readability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "checks",
            "passed",
            "withFindings"
          ],
          "description": "Present when a readability check applied to the site: how many of the applicable agent-readability checks came out clean. A count, not a quality judgment.",
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "checks": {
              "type": "integer",
              "minimum": 1
            },
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "withFindings": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "suppressed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "suppressed": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/suppressed"
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "seaworthy"
        },
        "version": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "severity",
        "needs",
        "docs",
        "standards"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/checkId"
        },
        "title": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "needs": {
          "type": "array",
          "items": {
            "enum": [
              "html",
              "files",
              "browser",
              "network"
            ]
          },
          "uniqueItems": true
        },
        "docs": {
          "type": "string"
        },
        "standards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "checkId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "action",
        "find",
        "replace"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "const": "replace"
        },
        "find": {
          "type": "string",
          "minLength": 1
        },
        "replace": {
          "type": "string"
        },
        "needsInput": {
          "type": "boolean"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "message"
      ],
      "properties": {
        "check": {
          "$ref": "#/$defs/checkId"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkId",
        "severity",
        "message",
        "location",
        "fix",
        "fingerprint"
      ],
      "properties": {
        "checkId": {
          "$ref": "#/$defs/checkId"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "fix": {
          "$ref": "#/$defs/fix"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "description": "A ready-to-paste prompt that instructs an agent to fix this finding. Generated from the finding's data alone; identical in every output format."
        }
      }
    },
    "fix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary",
        "edits",
        "appliesTo"
      ],
      "properties": {
        "kind": {
          "enum": [
            "edit",
            "manual"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edit"
          }
        },
        "appliesTo": {
          "const": "built-output"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "description": "Relative to the site root, forward slashes.",
          "not": {
            "pattern": "^([a-zA-Z]:)?[\\\\/]|\\\\"
          }
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "approximateLine": {
          "type": "boolean"
        },
        "selector": {
          "type": "string"
        },
        "snippet": {
          "type": "string"
        }
      }
    },
    "severity": {
      "enum": [
        "error",
        "warning",
        "note"
      ]
    },
    "skipped": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "reason",
        "hint"
      ],
      "properties": {
        "check": {
          "$ref": "#/$defs/checkId"
        },
        "reason": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        }
      }
    },
    "suppressed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkId",
        "fingerprint",
        "file",
        "reason",
        "source"
      ],
      "properties": {
        "checkId": {
          "$ref": "#/$defs/checkId"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "inline",
            "config"
          ]
        },
        "expires": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  }
}
