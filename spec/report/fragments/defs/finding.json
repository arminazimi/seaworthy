{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkId",
    "severity",
    "message",
    "location",
    "fix",
    "fingerprint"
  ],
  "properties": {
    "checkId": {
      "$ref": "#/$defs/checkId"
    },
    "severity": {
      "$ref": "#/$defs/severity"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "$ref": "#/$defs/location"
    },
    "fix": {
      "$ref": "#/$defs/fix"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "description": "A ready-to-paste prompt that instructs an agent to fix this finding. Generated from the finding's data alone; identical in every output format."
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  }
}
