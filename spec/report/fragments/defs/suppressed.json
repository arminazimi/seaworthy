{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkId",
    "fingerprint",
    "file",
    "reason",
    "source"
  ],
  "properties": {
    "checkId": {
      "$ref": "#/$defs/checkId"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "file": {
      "type": "string"
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "inline",
        "config"
      ]
    },
    "expires": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
