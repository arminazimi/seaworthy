{
  "version": "1.0.0",
  "name": "Seaworthy",
  "tagline": "Ship sites agents can trust.",
  "taglineSecondary": "Verified before it sails.",
  "descriptor": "Verifies websites for agents.",
  "colors": {
    "abyss": { "value": "#15101A", "role": "Primary dark canvas" },
    "ink": { "value": "#2A1F2D", "role": "Elevated dark surface; dark mark on light surfaces" },
    "desertRose": { "value": "#C47A74", "role": "Waterline and warm accent on dark surfaces" },
    "roseDeep": { "value": "#A9514D", "role": "Rose on light surfaces (4.6:1 on sand)" },
    "roseLight": { "value": "#E3B0AA", "role": "Inner ring and accent text on dark surfaces" },
    "sand": { "value": "#F6EEE9", "role": "Primary light canvas and dark-mode text" },
    "mist": { "value": "#9A8F98", "role": "Secondary text on dark surfaces" },
    "seaTeal": { "value": "#2F6F73", "role": "Functional success only: passing" },
    "signalAmber": { "value": "#8A5A00", "role": "Functional warning only: warnings" },
    "alertRed": { "value": "#B3261E", "role": "Functional failure only: errors" }
  },
  "fonts": {
    "sans": "Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "mono": "\"IBM Plex Mono\", \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace"
  },
  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32, "12": 48, "16": 64, "24": 96, "32": 128 },
  "radius": { "compact": 8, "card": 16, "panel": 24 }
}
