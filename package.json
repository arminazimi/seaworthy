{
  "name": "seaworthy-monorepo",
  "private": true,
  "description": "Seaworthy verifies websites for agents. Monorepo for the CLI, MCP server, GitHub Action, and Agent Skills.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/verify packages/mcp packages/action",
    "test": "npm run build --silent && node --test \"packages/*/dist/tests/**/*.test.js\" \"planning/roadmap/*.test.mjs\" \"tools/brand/*.test.mjs\" \"tools/*.test.mjs\"",
    "roadmap:build": "node planning/roadmap/build.mjs",
    "roadmap:apply": "node planning/roadmap/apply.mjs",
    "check:roadmap": "node planning/roadmap/build.mjs --check",
    "check:layout": "node tools/check-layout.mjs",
    "check:changelog": "node tools/changelog.mjs --check",
    "changelog:fold": "node tools/changelog.mjs",
    "check:startup": "node tools/check-startup.mjs",
    "metrics": "node tools/metrics.mjs",
    "build:brand": "node tools/brand/build.mjs",
    "export:brand": "node tools/brand/export.mjs",
    "check:brand": "node tools/brand/build.mjs --check",
    "schema:build": "node tools/schema.mjs",
    "check:schema": "node tools/schema.mjs --check",
    "reference:build": "node tools/gen-check-reference.mjs",
    "check:reference": "node tools/gen-check-reference.mjs --check",
    "check": "npm run build && npm test && npm run check:startup && npm run check:roadmap && npm run check:layout && npm run check:changelog && npm run check:brand && npm run check:reference && npm run check:schema",
    "clean": "tsc -b --clean packages/verify packages/mcp packages/action"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@microsoft/jest-sarif": "^1.0.0-beta.0",
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "ajv6": "npm:ajv@^6.15.0",
    "typescript": "^5.9.0"
  }
}
