{
  "name": "seaworthy-monorepo",
  "private": true,
  "description": "Seaworthy verifies websites for agents. Monorepo for the CLI, MCP server, GitHub Action, Agent Skills, and reference theme.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/verify packages/mcp packages/action",
    "test": "npm run build --silent && node --test \"packages/*/dist/tests/**/*.test.js\" \"planning/roadmap/*.test.mjs\"",
    "roadmap:build": "node planning/roadmap/build.mjs",
    "roadmap:apply": "node planning/roadmap/apply.mjs",
    "check:roadmap": "node planning/roadmap/build.mjs --check",
    "check:layout": "node tools/check-layout.mjs",
    "check": "npm run build && npm test && npm run check:roadmap && npm run check:layout",
    "clean": "tsc -b --clean packages/verify packages/mcp packages/action"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
